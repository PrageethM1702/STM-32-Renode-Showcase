cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m4"
    nvic: nvic

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    priorityMask: 0xF0
    systickFrequency: 16000000
    IRQ -> cpu@0

flash: Memory.MappedMemory @ sysbus 0x08000000
    size: 0x100000

sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x20000

usart2: UART.STM32_UART @ sysbus <0x40004400, +0x100>
    -> nvic@38

rccRegisters: Python.PythonPeripheral @ sysbus 0x40023800
    size: 0x400
    initable: true
    script: '''
if not hasattr(self, "cr"):
    self.cr = 0
    self.cfgr = 0

if request.IsInit:
    self.cr = 0
    self.cfgr = 0
elif request.offset == 0x0:
    if request.IsWrite:
        self.cr = request.value
        if self.cr & (1 << 16):
            self.cr |= (1 << 17)
        else:
            self.cr &= ~(1 << 17)
    else:
        request.value = self.cr
elif request.offset == 0x8:
    if request.IsWrite:
        sw = request.value & 0x3
        request_value = (request.value & ~0xC) | (sw << 2)
        self.cfgr = request_value
    else:
        request.value = self.cfgr
'''

gpioPortA: GPIOPort.STM32_GPIOPort @ sysbus <0x40020000, +0x400>
    numberOfAFs: 16

gpioPortD: GPIOPort.STM32_GPIOPort @ sysbus <0x40020C00, +0x400>
    numberOfAFs: 16

adcRegisters: Python.PythonPeripheral @ sysbus 0x40012000
    size: 0x400
    initable: true
    script: '''
import random

if not hasattr(self, "sr"):
    self.sr = 0
    self.dr = 0

if request.IsInit:
    self.sr = 0
    self.dr = 0
elif request.offset == 0x0:
    if request.IsWrite:
        self.sr = request.value
    else:
        request.value = self.sr
elif request.offset == 0x8:
    if request.IsWrite:
        if request.value & (1 << 30):
            self.dr = random.randint(1800, 2300)
            self.sr = self.sr | (1 << 1)
    else:
        request.value = 0
elif request.offset == 0x4C:
    if request.IsWrite:
        pass
    else:
        request.value = self.dr
        self.sr = self.sr & ~(1 << 1)
else:
    if not request.IsWrite:
        request.value = 0
'''